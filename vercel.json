{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "routes": [
    { "src": "/explore", "dest": "/explore.html" },
    { "src": "/budaya", "dest": "/budaya.html" },
    { "src": "/teknologi", "dest": "/teknologi.html" },
    { "src": "/story", "dest": "/story.html" },
    { "src": "/map", "dest": "/map.html" },
    { "src": "/planner", "dest": "/planner.html" },
    { "src": "/itinerary", "dest": "/itinerary.html" },
    { "src": "/view", "dest": "/view.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
